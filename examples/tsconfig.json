{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "01-javascript/**/*.ts",
    "07-algorithms/**/*.ts",
    "04-ai-review-dojo/**/*.ts"
  ]
}
