+// 促销应用器：在新订单价格模块中恢复促销能力（PR：增强可扩展性）
+
+export interface PromotionResult {
+  finalAmount: number;
+  couponCode?: string;
+}
+
+/**
+ * 应用历史促销逻辑：根据券码调用促销服务计算折后价。
+ * 从旧版下单链路迁移而来，保持与 v1 行为一致。
+ */
+export async function applyPromotionLegacy(
+  amount: number,
+  couponCode: string,
+): Promise<PromotionResult> {
+  const resp = await fetch(`/api/v1/coupons/${encodeURIComponent(couponCode)}/apply`, {
+    method: 'POST',
+    body: JSON.stringify({ amount }),
+  });
+  const data = (await resp.json()) as { discountedAmount: number };
+  return {
+    finalAmount: data.discountedAmount ?? amount,
+    couponCode,
+  };
+}
