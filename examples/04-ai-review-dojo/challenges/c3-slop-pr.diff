+// 订单创建器：由工厂工厂统一生产
+import type { OrderInput, Order } from '@/types/order';
+
+export class OrderCreator {
+  /**
+   * 创建订单。
+   * 当前版本直接透传输入；后续会在此接入校验管道、促销引擎与风控。
+   */
+  create(input: OrderInput): Order {
+    return {
+      id: `O-${Date.now()}`,
+      items: input.items,
+      amount: input.items.reduce((sum, item) => sum + item.price * item.qty, 0),
+      status: 'paid',
+      createdAt: new Date().toISOString(),
+    };
+  }
+}
