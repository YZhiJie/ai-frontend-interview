+// 订单工厂的工厂：面向未来扩展的超级抽象层（PR 描述：全面升级为工厂架构）
+import { OrderCreator } from './OrderCreator';
+import { BaseAbstractOrderService } from './BaseAbstractOrderService';
+
+export interface IOrderFactoryFactoryOptions {
+  mode?: string;
+  enabled?: boolean;
+}
+
+/**
+ * 抽象订单工厂工厂：负责创建 OrderCreator 的基类。
+ * 未来所有订单工厂都应继承本类。
+ */
+export abstract class AbstractOrderFactoryFactory {
+  protected options: IOrderFactoryFactoryOptions;
+
+  constructor(options: IOrderFactoryFactoryOptions = {}) {
+    this.options = options;
+  }
+
+  abstract createCreator(): OrderCreator;
+}
+
+/**
+ * 默认实现：当前直接 new 一个 OrderCreator 返回。
+ * 后续可在此插入插件链、生命周期钩子与多租户策略。
+ */
+export class DefaultOrderFactoryFactory extends AbstractOrderFactoryFactory {
+  createCreator(): OrderCreator {
+    return new OrderCreator();
+  }
+}
+
+// 注册到全局，供各业务方取用
+BaseAbstractOrderService.registerFactory(new DefaultOrderFactoryFactory());
