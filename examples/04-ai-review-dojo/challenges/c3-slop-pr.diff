+// 订单服务抽象基类：与工厂工厂配套的基础设施层
+import type { AbstractOrderFactoryFactory } from './AbstractOrderFactoryFactory';
+
+export abstract class BaseAbstractOrderService {
+  private static factory: AbstractOrderFactoryFactory | null = null;
+
+  static registerFactory(factory: AbstractOrderFactoryFactory): void {
+    BaseAbstractOrderService.factory = factory;
+  }
+
+  static getFactory(): AbstractOrderFactoryFactory | null {
+    return BaseAbstractOrderService.factory;
+  }
+}
